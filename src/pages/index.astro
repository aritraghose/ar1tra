---
import Layout from "../layouts/Layout.astro";
import ProfileCard from "../components/ProfileCard.astro";
import { profileLinks, linkAttrs } from "../data/links";
import displayPicture from "../assets/displayPicture.jpg";

// const projects = [
// 	{
// 		name: "",
// 		description: "",
// 	},
// ];

// const experiences = [
// 	{
// 		role: "",
// 		company: "",
// 	},

// ];
---

<Layout title="ar1tra">
	<main class="flex flex-col gap-12">
		<!-- Header Links -->
		<header class="flex gap-2 text-sm text-muted">
			{profileLinks.map((link, i) => (
				<>
					{i > 0 && <span>//</span>}
					<a href={link.href} {...linkAttrs(link)}>{link.label}</a>
				</>
			))}
		</header>

		<!-- Intro -->
		<section class="space-y-3">
			<button
				type="button"
				id="avatarTrigger"
				class="avatar-trigger"
				aria-haspopup="dialog"
				aria-controls="profileCardDialog"
				aria-label="Open profile card"
			>
				<img src={displayPicture.src} alt="Aritra Ghose" class="w-24 h-24 rounded-sm object-cover" />
			</button>
			<div>
				<h1 class="text-lg font-medium text-heading">Aritra Ghose</h1>
				<p class="text-subtle">Software Engineer</p>
			</div>
		</section>

		<!-- Currently -->
		<section class="space-y-3">
			<h2 class="text-base font-medium text-muted">Currently</h2>
			<p class="text-body leading-relaxed">
				I'm building <a href="https://github.com/aritraghose/dueboard" target="_blank" rel="noopener noreferrer"
					>something useful</a
				> while also actively looking for job in engineering roles.
			</p>
		</section>

		<!-- Work -->
		<!-- <section class="space-y-4">
			<h2 class="text-base font-medium text-muted">Work</h2>
			<div class="space-y-3">
				{
					projects.map((project) => (
						<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between group">
							<a
								href="#"
								class="font-medium text-heading underline decoration-gray-300 underline-offset-4 group-hover:decoration-black transition-colors shrink-0"
							>
								{project.name}
							</a>
							<span class="text-muted text-sm hidden sm:block mx-2 border-b border-gray-100 flex-grow" />
							<span class="text-subtle text-sm">
								{project.description}
							</span>
						</div>
					))
				}
			</div>
		</section> -->

		<!-- Experience -->
		<!-- <section class="space-y-4">
			<h2 class="text-base font-medium text-muted">Experience</h2>
			<div class="space-y-2">
				{
					experiences.map((exp) => (
						<div class="text-body">
							<a href="#" class="text-blue-600 hover:underline">
								{exp.company}
							</a>
							<span class="text-subtle"> as </span>
							<span class="font-medium">{exp.role}</span>
						</div>
					))
				}
			</div>
		</section> -->

		<!-- Education -->
		<section class="space-y-4">
			<h2 class="text-base font-medium text-muted">Education</h2>
			<div class="flex justify-between items-start">
				<div>
					<span class="font-medium text-body">BRAC University</span>
					<p class="text-subtle">Bachelor of Science in Computer Science and Engineering</p>
				</div>
				<span class="text-muted text-sm">2021-2025</span>
			</div>
		</section>

		<!-- Footer -->
		<footer class="flex flex-1 flex-col pt-8 text-subtle">
			<p>
				If you want to know more about me, connect me on <a
					href="https://x.com/ar1tra">twitter/x</a
				> or a bunch of other places <a href="/connect">here.</a>
			</p>
			<p class="mt-auto pt-16 text-center font-mono text-xs text-faint">
				<a href="https://github.com/aritraghose/ar1tra" target="_blank" rel="noopener noreferrer">view-source://ar1tra</a>
				<span class="mx-2">//</span>
				<a href="/trace">trace</a>
			</p>
		</footer>
	</main>
	<ProfileCard avatarSrc={displayPicture.src} />
</Layout>
