---
import ThemeIcon from "./ThemeIcon.astro";

const navItems = [
	{ href: "/about", label: "about" },
	{ href: "/posts", label: "posts" },
	{ href: "/projects", label: "projects" },
	{ href: "/connect", label: "connect" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-8 -mt-8">
	<a href="/" class="flex items-center gap-2 mr-auto no-underline hover:no-underline">
		<img src="/icon.png" alt="ar1tra" class="w-5 h-5 rounded-sm" />
		<span class="font-medium text-heading">ar1tra</span>
	</a>
	<nav class="site-nav" aria-label="Primary">
		{navItems.map((item) => (
			<a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
				{item.label}
			</a>
		))}
	</nav>
	<ThemeIcon />
</header>
