---
import { Sun, Moon } from "@lucide/astro";
---

<button id="themeToggle" aria-label="Toggle theme" class="cursor-pointer">
  <Sun class="block dark:hidden" size={18} />
  <Moon class="hidden dark:block" size={18} />
</button>

<script>
  // Initial theme is set in <head> by /theme.js; this only handles the toggle.
  document.getElementById("themeToggle")?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {}
  });
</script>
