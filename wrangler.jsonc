{
	"main": "@astrojs/cloudflare/entrypoints/server",
	"name": "ar1tra",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "ar1tra.com",
      "custom_domain": true
    }
  ]
}
